#!/usr/bin/env python3
"""Reject staged agent-authored files over 20,000 bytes.

Binary files and paths marked `linguist-generated` or `linguist-vendored` in
.gitattributes are exempt. Enable with `git config core.hooksPath .githooks`.
"""

import subprocess
import sys

MAX_BYTES = 20_000
EXEMPT_ATTRIBUTES = ("linguist-generated", "linguist-vendored")

SPLIT_INSTRUCTIONS = f"""
Split each file into smaller files of at most {MAX_BYTES:,} bytes, then commit again:

  1. Find the seams. List the file's types, extensions, test suites, or headings
     and group them by the one purpose each serves.
  2. Move each group into its own file next to the original, named after what it
     holds (one type per file, grouped by feature):
       - Swift type: move extensions to `Type+Purpose.swift`, or nested and helper
         types to `HelperType.swift`. A `private` member used by a moved extension
         becomes internal; `fileprivate` does not reach across files.
       - Swift tests: split one `@Suite` or `XCTestCase` per behavior into
         `TypeBehaviorTests.swift`. Move shared fixtures to `TypeTestSupport.swift`.
       - Python tests: move each `TestCase` class to its own `test_<topic>.py`;
         move shared helpers to a module without the `test_` prefix.
       - Markdown: split at `##` headings into `docs/<topic>/<part>.md` and leave
         the original as a short index that links each part. Fix inbound links.
  3. XcodeGen adds new files under Sources/ and Tests/ to their targets: run
     `./Scripts/run.sh generate`, then `./Scripts/run.sh test`.
  4. Stage the original and every new file.

Not written by hand (lockfile, codegen, vendored)? Mark the path in .gitattributes
with `linguist-generated` or `linguist-vendored` instead of splitting it.
"""


def git(*args: str) -> str:
    return subprocess.run(
        ("git", *args), capture_output=True, text=True, check=True
    ).stdout


def staged_text_files() -> list[str]:
    # numstat prints "-\t-\tpath" for binary files.
    rows = git(
        "diff", "--cached", "--numstat", "-z", "--no-renames", "--diff-filter=ACMR"
    ).split("\0")
    return [
        path
        for added, _, path in (row.split("\t", 2) for row in rows if row)
        if added != "-"
    ]


def exempt_paths(paths: list[str]) -> set[str]:
    if not paths:
        return set()
    # -z output: path, attribute, value, repeated.
    fields = git(
        "check-attr", "--cached", "-z", *EXEMPT_ATTRIBUTES, "--", *paths
    ).split("\0")
    return {
        path
        for path, _, value in zip(fields[0::3], fields[1::3], fields[2::3])
        if value not in ("unspecified", "unset")
    }


def main() -> int:
    paths = staged_text_files()
    exempt = exempt_paths(paths)
    oversized = []
    for path in paths:
        if path in exempt:
            continue
        size = int(git("cat-file", "-s", f":{path}"))
        if size > MAX_BYTES:
            oversized.append((path, size))

    if not oversized:
        return 0

    print(f"pre-commit: staged files over {MAX_BYTES:,} bytes:\n", file=sys.stderr)
    for path, size in oversized:
        print(f"  {path}: {size:,} bytes", file=sys.stderr)
    print(SPLIT_INSTRUCTIONS, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
