    "inputMonitoringOffDetail" : {
      "comment" : "Menu bar notice detail. %1$@ and %2$@ are both the app name, Keyameleon.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل %1$@ في «مراقبة الإدخال». هل هو قيد التشغيل بالفعل؟ أعد تشغيل %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on %1$@ in Input Monitoring. Already on? Restart %2$@."
