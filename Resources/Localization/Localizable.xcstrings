    "unsupportedDevicesHelp" : {
      "comment" : "Tooltip of the unsupported devices section.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Keyameleon التمييز بين هذه الأجهزة بشكل موثوق، لذا لا يمكن تعيين مصدر إدخال لها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleon can’t tell these devices apart reliably, so they can’t have an input source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleon no puede distinguir estos dispositivos de forma fiable, así que no pueden tener una fuente de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleon ne peut pas distinguer ces appareils de façon fiable : ils ne peuvent donc pas avoir de méthode de saisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleon non riesce a distinguere questi dispositivi in modo affidabile, quindi non possono avere una sorgente di input."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleonはこれらのデバイスを確実に区別できないため、入力ソースを割り当てられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleon이 이 기기들을 확실하게 구별할 수 없어 입력 소스를 지정할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleon 无法可靠地区分这些设备，因此无法为它们指定输入法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyameleon 無法可靠地分辨這些裝置，因此無法為它們指定輸入方式。"
          }
        }
      }
    },
