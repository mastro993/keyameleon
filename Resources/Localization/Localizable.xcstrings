    "setupFooterAssignments" : {
      "comment" : "Guided setup sidebar note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى التعيينات على جهاز Mac هذا. يمكنك تغييرها في أي وقت من الإعدادات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assignments stay on this Mac. Change them any time in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las asignaciones se quedan en este Mac. Cámbialas cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les attributions restent sur ce Mac. Modifiez-les à tout moment dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le assegnazioni restano su questo Mac. Puoi modificarle in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "割り当てはこのMacに保存されます。「設定」でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지정 내용은 이 Mac에만 저장됩니다. 설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定设置仅保存在这台 Mac 上，可随时在“设置”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定設定只會保留在這台 Mac 上，隨時可在「設定」中更改。"
          }
        }
      }
    },
    "setupFooterPermission" : {
      "comment" : "Guided setup sidebar privacy note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُحفظ ما تكتبه ولا يُسجَّل ولا يُرسَل إلى أي مكان أبدًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type is never saved, logged, or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escribes nunca se guarda, se registra ni se envía a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous tapez n’est jamais sauvegardé, consigné ni envoyé nulle part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che digiti non viene mai salvato, registrato o inviato da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力した内容が保存・記録されたり、どこかに送信されたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력한 내용은 저장되거나 기록되지 않고, 어디로도 전송되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你输入的内容不会被保存、记录或发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你輸入的內容絕不會被儲存、記錄或傳送到任何地方。"
          }
        }
      }
    },
