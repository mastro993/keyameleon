    "persistenceChangeNotSaved" : {
      "comment" : "Detail of the saved keyboards unavailable notice.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم حفظ آخر تغيير أجريته. تحقق من المساحة الخالية على القرص ومن إمكانية الوصول إلى مجلد المكتبة، ثم انقر على «إعادة المحاولة»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last change wasn’t saved. Check free disk space and access to your Library folder, then click Retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha guardado tu último cambio. Comprueba el espacio libre en disco y el acceso a tu carpeta Librería y, después, haz clic en Reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dernière modification n’a pas été enregistrée. Vérifiez l’espace disque disponible et l’accès à votre dossier Bibliothèque, puis cliquez sur Réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultima modifica non è stata salvata. Controlla lo spazio libero su disco e l’accesso alla cartella Libreria, poi fai clic su Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後の変更は保存されませんでした。ディスクの空き容量と「ライブラリ」フォルダへのアクセス権を確認してから、「再試行」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 변경 사항이 저장되지 않았습니다. 디스크 여유 공간과 라이브러리 폴더 접근 권한을 확인한 다음 '재시도'를 클릭하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的上一次更改未存储。请检查可用磁盘空间以及对“资源库”文件夹的访问权限，然后点按“重试”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最後的更動未儲存。請檢查可用磁碟空間及「資源庫」檔案夾的取用權限，然後按一下「重試」。"
          }
        }
      }
    },
