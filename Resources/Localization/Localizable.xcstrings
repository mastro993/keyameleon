    "ignoredKeyboardHelp" : {
      "comment" : "Tooltip of an ignored device row. ⋯ is the actions menu button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تبدّل الأجهزة المتجاهَلة مصدر الإدخال أبدًا. استخدم ⋯ لإيقاف التجاهل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignored devices never switch the input source. Use ⋯ to stop ignoring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos ignorados nunca cambian la fuente de entrada. Usa ⋯ para dejar de ignorarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils ignorés ne changent jamais la méthode de saisie. Utilisez ⋯ pour ne plus les ignorer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi ignorati non cambiano mai la sorgente di input. Usa ⋯ per non ignorarli più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無視したデバイスで入力ソースが切り替わることはありません。無視を解除するには⋯を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무시된 기기는 입력 소스를 전환하지 않습니다. 무시를 해제하려면 ⋯을 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已忽略的设备永远不会切换输入法。使用 ⋯ 停止忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
