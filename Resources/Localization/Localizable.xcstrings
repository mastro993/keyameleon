    "inputSourceRemovedHelp" : {
      "comment" : "Tooltip for an unavailable input source. Use the official macOS names of System Settings and its Keyboard pane.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد مصدر الإدخال هذا موجودًا في macOS. اختر مصدرًا آخر، أو أعد إضافته في إعدادات النظام › لوحة المفاتيح."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
