    "assignmentsDescription" : {
      "comment" : "Guided setup keyboards step description. Ignore is a menu item name and must match its translation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مصدر إدخال لكل لوحة مفاتيح. ليست لوحة مفاتيح؟ اختر «تجاهل» من قائمة ⋯ الخاصة بها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick an input source for each keyboard. Not a keyboard? Choose Ignore from its ⋯ menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una fuente de entrada para cada teclado. ¿No es un teclado? Selecciona Ignorar en su menú ⋯."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une méthode de saisie pour chaque clavier. Ce n’est pas un clavier ? Choisissez Ignorer dans son menu ⋯."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una sorgente di input per ogni tastiera. Non è una tastiera? Scegli Ignora dal suo menu ⋯."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードごとに入力ソースを選びます。キーボードではない場合は、⋯メニューから「無視」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드마다 입력 소스를 고르세요. 키보드가 아닌 기기라면 ⋯ 메뉴에서 '무시'를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个键盘选择一个输入法。不是键盘？请从其 ⋯ 菜单中选择“忽略”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每個鍵盤選擇一種輸入方式。不是鍵盤？請從其 ⋯ 選單中選擇「忽略」。"
          }
        }
      }
    },
