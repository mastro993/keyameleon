    "holdUntilKeyboardChange" : {
      "comment" : "Menu bar notice detail. %@ is an input source name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى %@ حتى تكتب على لوحة مفاتيح أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stays until you type on another keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se mantiene hasta que escribas en otro teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La méthode %@ reste en place jusqu’à ce que vous tapiez sur un autre clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resta attiva finché non scrivi su un’altra tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、別のキーボードで入力するまで維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 입력 소스는 다른 키보드로 입력할 때까지 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将保持不变，直到你在其他键盘上打字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會保留到你在其他鍵盤上打字。"
          }
        }
      }
    },
